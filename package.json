{
  "name": "rpg-map-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" && playwright test --project=chromium",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test --project=chromium",
    "test:firebase-rules": "firebase emulators:exec --project demo-rpg-map-display-rules --only firestore,database \"node --test tests/firebaseRules.emulator.test.mjs\"",
    "verify": "pnpm run typecheck && pnpm run check-deps && pnpm run test:unit && pnpm run test:e2e && pnpm run test:gestes",
    "serve": "node scripts/serve.mjs",
    "maps:prepare": "node scripts/prepare-maps.mjs",
    "maps:tool": "node scripts/prepare-server.mjs",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "stamp": "node scripts/stamp-version.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check-deps": "node scripts/check-deps.mjs --coherence",
    "check-deps:availability": "node scripts/check-deps.mjs --availability",
    "test:gestes": "playwright test --project=manuel",
    "test:manuel": "playwright test --project=manuel",
    "test:mesures": "playwright test --project=mesures"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@jimp/wasm-webp": "^1.6.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.26.0",
    "jimp": "^1.6.1",
    "typescript": "^5.7.0"
  },
  "build": 35
}
