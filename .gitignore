node_modules/
.pnpm-store/
test-results/
playwright-report/
_site/
fixtures/real/*
!fixtures/real/.gitkeep

# Sources d'export VTT : lourdes, jamais téléchargées à l'exécution.
#
# Seuls les artefacts de maps/generated/ sont servis ; `sourceUrl` du catalogue
# n'est qu'une chaîne validée par `js/import/catalog.js`, jamais suivie. Le
# le paquet Pages est construit par liste blanche dans `_site`, donc une source
# commitée ne part plus automatiquement sur le web.
#
# Deux conséquences à connaître :
# - `manoir-rdc.uvtt` reste suivi, car .gitignore ne désuit pas un fichier déjà
#   commité. La règle vaut pour la suite, pas rétroactivement.
# - sur un clone sans les sources, `pnpm maps:prepare` republierait un catalogue
#   amputé des cartes absentes. La préparation se fait sur le poste qui détient
#   les sources — comme fixtures/real/, et pour la même raison.
maps/*.dd2vtt
maps/*.df2vtt

# Fonds animés et leurs affiches : même raisonnement, en plus lourd encore. Un WebM de
# carte pèse des dizaines de mégaoctets, et seule la copie de maps/generated/ est servie.
# L'affiche est reproductible par `node scripts/extract-poster.mjs`.
maps/*.webm
maps/*.mp4
maps/*.poster.webp

# Bac à sable d'essais vidéo du mainteneur : exports bruts de Dungeon Alchemist.
maps/test video/

# Variantes du comparateur de l'outil local : jetables par construction, et publiées avec
# le reste du dépôt si on les commitait. Elles servent à décider d'un réglage, jamais à le
# porter — la décision se fixe dans les constantes de scripts/resample.mjs.
maps/.preview/

# Cache de fabrication des cartes. Jamais une source de vérité : le perdre coûte une passe
# complète, jamais une carte. Hors de git à dessein — un cache commité peut entrer en
# conflit à la fusion, et son seul gain serait d'épargner une minute sur un clone neuf.
maps/generated/.recipes.json
.DS_Store
*.log
# Configuration Claude Code. Le dossier était ignoré en entier, ce qui empêchait le crochet
# et les skills d'atteindre l'autre machine — or les deux machines ne se parlent que par git.
# On garde donc ce qui est partagé, et on continue d'ignorer ce qui est personnel :
# `settings.local.json` porte des permissions propres au poste.
.claude/*
!.claude/settings.json
!.claude/skills/

# Boite aux lettres du test de reveil Antigravity (18/08/2026). Jetable.
bridge/
